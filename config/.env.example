# 首次启动可直接在网页向导填写；也可提前复制为 config/.env 后手动填写。
# config/.env 已被 Git 忽略，切勿提交真实密钥、内部地址或模型名称。

# LLM（OpenAI 兼容 API 根地址，不要带 /chat/completions）
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL_NAME=

# Embedding（OpenAI 兼容 API 根地址，不要带 /embeddings）
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL_NAME=

# 可选：HTTP reranker API 根地址和模型名称；首次启动也可以在网页中填写。
RERANKER_API_BASE=
RERANKER_EXPECTED_MODEL=

# 系统认证：生产环境请填入随机值；本地首次启动可留空，由应用生成。
SESSION_SECRET=
# 可选：给内部 Agent/服务调用使用的固定管理员 Bearer 令牌
# AUTH_BEARER_TOKEN=
# 生产环境首次设置管理员密码必须提供此令牌；初始化完成后可删除。
# AUTH_BOOTSTRAP_ADMIN_TOKEN=replace-with-a-random-secret
# 可选：关闭后改为固定过期，不再按活跃时间自动续期
# SESSION_SLIDING_EXPIRATION_ENABLED=true
